{
  "name": "react-agent-web-sdk",
  "version": "0.0.1",
  "description": "Agent Web SDK with SolidJS UI - Complete chat interface for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:browser",
    "build:lib": "vite build --mode lib",
    "build:browser": "vite build --mode browser",
    "dev:browser": "vite --mode browser",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "ai",
    "chat",
    "solidjs",
    "sdk",
    "websocket",
    "ui"
  ],
  "author": "react-base-service",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "code-inspector-plugin": "^1.6.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "marked": "^16.2.1",
    "sass-embedded": "^1.85.1",
    "solid-js": "^1.9.13",
    "typescript": "^5.3.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "rollup": "4.62.2"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/json": "^2.2.444",
    "@iconify/utils": "^3.1.3",
    "@lexical/history": "^0.45.0",
    "@lexical/plain-text": "^0.45.0",
    "copy-to-clipboard": "3.3.3",
    "diff": "^8.0.4",
    "highlight.js": "^11.11.1",
    "lexical": "^0.45.0",
    "morphdom": "^2.7.8",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-solid": "^0.5.6"
  }
}
