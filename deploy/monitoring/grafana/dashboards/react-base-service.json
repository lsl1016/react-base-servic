{
  "uid": "react-base-service",
  "title": "react-base-service 业务监控",
  "tags": ["react-base-service"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "服务存活",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "up{job=\"react-base-service\"}", "legendFormat": "up" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run 终态速率（按 status）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 10, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(react_runs_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "当前负载（活跃 run / WS 连接）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 10, "x": 14, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "react_runs_active", "legendFormat": "活跃 run" },
        { "refId": "B", "expr": "react_ws_connections", "legendFormat": "WS 连接" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "模型单轮耗时 P95（按 model）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(react_model_round_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(react_model_round_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}} (P50)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "工具调用速率（按 tool/status，Top 10）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (tool, status) (rate(react_tool_calls_total[5m])))",
          "legendFormat": "{{tool}} [{{status}}]"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "工具执行耗时 P95（按 tool）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(react_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "模型互备切换（近 1h 新增次数）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "increase(react_model_failovers_total[1h])", "legendFormat": "failover" },
        { "refId": "B", "expr": "increase(react_sessions_created_total[1h])", "legendFormat": "新建会话" }
      ]
    }
  ]
}
